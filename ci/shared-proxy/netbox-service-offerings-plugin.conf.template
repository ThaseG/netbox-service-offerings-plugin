# Rendered by ci/scripts/render-proxy-conf.sh (plain `envsubst`, restricted to
# ${NETBOX_DOMAIN} only) into $EDGE_CONF_DIR/${NETBOX_DOMAIN}.conf on the
# shared front-door proxy — see ci/shared-proxy/README.md. nginx's own
# $host/$scheme/etc runtime variables below are left untouched by that
# restriction.
#
# proxy_pass targets `netbox-service-offerings-plugin`, this repo's own
# stable network alias on the shared "netbox-edge" Docker network (set in
# ci/docker/docker-compose.yml) — resolvable by the front door regardless of
# which compose project actually created that container.
#
# That target is resolved via Docker's embedded DNS (127.0.0.11) through a
# variable + `resolver` directive, not a plain `proxy_pass http://name:port`
# — plain proxy_pass resolves its hostname once, at config-load time, and
# nginx refuses to even start (let alone reload) if that name doesn't
# resolve yet. Since this repo's own container is torn down by Pre-Clean at
# the start of every deploy and not recreated until *after* this file is
# rendered and reloaded (see ci-cd.yml), a plain proxy_pass would crash-loop
# the whole front door on every single deploy, not just the very first one.
# Resolving per-request instead means a request that arrives before the
# container is back up just gets a 502, and the front door itself keeps
# running throughout.

server {
    listen 80;
    listen [::]:80;
    server_name ${NETBOX_DOMAIN};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${NETBOX_DOMAIN};

    ssl_certificate     /etc/nginx/certs/${NETBOX_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/${NETBOX_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    client_max_body_size 25m;

    location / {
        resolver 127.0.0.11 valid=10s;
        set $upstream netbox-service-offerings-plugin;
        proxy_pass http://$upstream:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
